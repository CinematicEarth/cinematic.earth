{
  "name": "cinematic.earth",
  "version": "1.0.0",
  "type": "module",
  "description": "Stunning Earth cinematography from Rick Memsic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CinematicEarth/cinematic.earth.git"
  },
  "homepage": "https://cinematic.earth",
  "bugs": {
    "url": "https://github.com/CinematicEarth/cinematic.earth/issues"
  },
  "author": "Garrett Brown <eigendebugger@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "keywords": [
    "calm",
    "environment",
    "health",
    "meditation",
    "mindfulness",
    "nature",
    "ocean",
    "peace",
    "relaxation",
    "serenity",
    "spirituality",
    "surf",
    "surfing",
    "tranquility",
    "water",
    "waves",
    "wellness",
    "zen"
  ],
  "scripts": {
    "audit-ci": "audit-ci --config audit-ci.json",
    "build": "tsc && vite build",
    "clean": "rm -rf dist node_modules",
    "dev": "vite dev --host",
    "format": "prettier --write . && eslint --fix .",
    "lint": "prettier --check . && eslint .",
    "preview": "vite preview",
    "push": "pnpm build && gh-pages --branch main --repo git@github.com-eigendude:CinematicEarth/cinematicearth.github.io.git --dist dist --dotfiles",
    "start": "vite",
    "test": "vitest run --passWithNoTests",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "shaka-player": "^5.2.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "audit-ci": "^7.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "gh-pages": "^6.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-pkg": "^0.22.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "bundleDependencies": false,
  "target": "web"
}
